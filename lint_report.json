"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4416,4419],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":120,"column":79,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":120,"endColumn":82,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4430,4433],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4430,4433],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { getAptosWallets, AptosWallet, NetworkInfo } from '@aptos-labs/wallet-standard';\nimport { DEFAULT_NETWORK } from './networks';\n\nlet _wallet: AptosWallet | undefined;\n\n// Wait for wallet to be injected with retries\nexport const waitForWallet = async (maxRetries = 10, delayMs = 200): Promise<AptosWallet | undefined> => {\n    for (let i = 0; i < maxRetries; i++) {\n        const wallet = getWallet();\n        if (wallet) {\n            return wallet;\n        }\n        await new Promise(resolve => setTimeout(resolve, delayMs));\n    }\n    return undefined;\n};\n\nexport const getWallet = (): AptosWallet | undefined => {\n    if (_wallet) return _wallet;\n\n    // Try to get Nightly wallet from window.nightly.aptos\n    const nightlyAptos = (window as any).nightly?.aptos;\n    if (nightlyAptos) {\n        // Nightly injects a standardWallet property\n        if (nightlyAptos.standardWallet) {\n            _wallet = nightlyAptos.standardWallet as AptosWallet;\n            return _wallet;\n        }\n        // Alternatively, try to use it directly if it has the AptosWallet interface\n        if (nightlyAptos.features && nightlyAptos.features['aptos:connect']) {\n            _wallet = nightlyAptos as AptosWallet;\n            return _wallet;\n        }\n    }\n\n    // Fallback: Use wallet-standard to detect all Aptos wallets\n    try {\n        const { aptosWallets } = getAptosWallets();\n\n        // Find Nightly wallet\n        const nightlyWallet = aptosWallets.find(w =>\n            w.name.toLowerCase().includes('nightly')\n        );\n\n        if (nightlyWallet) {\n            _wallet = nightlyWallet;\n            return _wallet;\n        }\n\n        // Return first available wallet if Nightly not found\n        if (aptosWallets.length > 0) {\n            _wallet = aptosWallets[0];\n            return _wallet;\n        }\n    } catch (e) {\n        console.warn('Failed to get Aptos wallets via wallet-standard:', e);\n    }\n\n    return undefined;\n};\n\nexport const connectWallet = async (wallet: AptosWallet): Promise<any> => {\n    const connectFeature = wallet.features['aptos:connect'];\n    if (!connectFeature) {\n        throw new Error('Wallet does not support connect');\n    }\n\n    const networkInfo: NetworkInfo = {\n        chainId: DEFAULT_NETWORK.chainId,\n        name: DEFAULT_NETWORK.name as any,\n        url: DEFAULT_NETWORK.url,\n    };\n\n    const response = await connectFeature.connect(false, networkInfo);\n    return response;\n};\n\nexport const disconnectWallet = async (wallet: AptosWallet): Promise<void> => {\n    const disconnectFeature = wallet.features['aptos:disconnect'];\n    if (disconnectFeature) {\n        await disconnectFeature.disconnect();\n    }\n};\n\nexport const getWalletNetwork = async (wallet: AptosWallet): Promise<NetworkInfo | undefined> => {\n    const networkFeature = wallet.features['aptos:network'];\n    if (networkFeature) {\n        return networkFeature.network as unknown as NetworkInfo;\n    }\n    return undefined;\n};\n\nexport const changeWalletNetwork = async (wallet: AptosWallet, networkInfo: NetworkInfo): Promise<any> => {\n    const changeNetworkFeature = wallet.features['aptos:changeNetwork'];\n    if (!changeNetworkFeature) {\n        throw new Error('Wallet does not support network change');\n    }\n    return changeNetworkFeature.changeNetwork(networkInfo);\n};\n\nexport const signAndSubmitTransaction = async (wallet: AptosWallet, payload: any): Promise<any> => {\n    const signFeature = wallet.features['aptos:signAndSubmitTransaction'];\n    if (!signFeature) {\n        throw new Error('Wallet does not support signAndSubmitTransaction');\n    }\n    // standard aptos:signAndSubmitTransaction often requires { payload: ... } structure\n    // or sometimes just the payload itself. The error 'serialize of undefined' suggests \n    // it might be looking for a property that doesn't exist on the passed object.\n    // Let's try wrapping it, as this is a common variance.\n    // Try passing payload directly first (standard behavior)\n    try {\n        return await signFeature.signAndSubmitTransaction(payload);\n    } catch (e) {\n        console.warn(\"Direct signAndSubmitTransaction failed, trying with payload wrapper:\", e);\n        // Fallback: standard aptos:signAndSubmitTransaction sometimes requires { payload: ... }\n        return await signFeature.signAndSubmitTransaction({ payload } as any);\n    }\n};\n\nexport const signMessage = async (wallet: AptosWallet, message: any): Promise<any> => {\n    const signFeature = wallet.features['aptos:signMessage'];\n    if (!signFeature) {\n        throw new Error('Wallet does not support signMessage');\n    }\n    return signFeature.signMessage(message);\n};\n","usedDeprecatedRules":[]},{"filePath":"/home/antony/intent-protocol/packages/frontend/src/lib/wallet/networks.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/antony/intent-protocol/packages/frontend/src/main.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/antony/intent-protocol/packages/frontend/src/pages/AddTokenPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/antony/intent-protocol/packages/frontend/src/pages/CrossChainPage.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'destTokens' and 'sourceTokens'. Either include them or remove the dependency array.","line":60,"column":8,"nodeType":"ArrayExpression","endLine":60,"endColumn":19,"suggestions":[{"desc":"Update the dependencies array to be: [destTokens, direction, sourceTokens]","fix":{"range":[3076,3087],"text":"[destTokens, direction, sourceTokens]"}}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":133,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":133,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5526,5529],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5526,5529],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from 'react';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\n\nimport { ArrowDown, ArrowLeftRight, Loader2, RotateCw } from 'lucide-react';\nimport { toast } from 'sonner';\nimport { useWallet as useAptosWallet } from \"@/context/wallet-provider\";\nimport { useWallet as useSolanaWallet } from \"@solana/wallet-adapter-react\";\nimport { WalletMultiButton, useWalletModal as useWalletMultiButton } from \"@solana/wallet-adapter-react-ui\";\nimport { PriceService } from '@/lib/pyth';\nimport { Token } from '@/types';\nimport { useCrossChain } from '@/context/CrossChainContext';\n\n// Token Definitions (Simplified for Demo)\n// Token Definitions (Simplified for Demo)\nconst MOV_TOKENS: Token[] = [\n    { symbol: \"MOVE\", type: \"0x1::aptos_coin::AptosCoin\", decimals: 8, name: \"Movement\", icon: \"https://raw.githubusercontent.com/hippospace/aptos-coin-list/main/icons/MOVE.svg\" },\n    { symbol: \"USDC\", type: \"0x45142fb00dde90b950183d8ac2815597892f665c254c3f42b5768bc6ae4c8489\", decimals: 6, name: \"USDC (M)\", icon: \"https://raw.githubusercontent.com/hippospace/aptos-coin-list/main/icons/USDC.svg\" },\n];\n\nconst SOL_TOKENS: Token[] = [\n    { symbol: \"SOL\", type: \"11111111111111111111111111111111\", decimals: 9, name: \"Solana\", icon: \"https://raw.githubusercontent.com/solana-labs/token-list/main/assets/mainnet/So11111111111111111111111111111111111111112/logo.png\" },\n    { symbol: \"USDC\", type: \"4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU\", decimals: 6, name: \"USDC (S)\", icon: \"https://raw.githubusercontent.com/solana-labs/token-list/main/assets/mainnet/EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v/logo.png\" }, // Devnet USDC-ish\n];\n\nexport default function CrossChainPage() {\n    // Chain Direction: 'MOV_TO_SOL' or 'SOL_TO_MOV'\n    const [direction, setDirection] = useState<'MOV_TO_SOL' | 'SOL_TO_MOV'>('MOV_TO_SOL');\n\n    const { createMovementToSolanaSwap, createSolanaToMovementSwap, isLoading: isContextLoading } = useCrossChain();\n\n    // Wallets\n    const aptos = useAptosWallet();\n    const solana = useSolanaWallet();\n    const { setVisible } = useWalletMultiButton();\n\n    // Constant imports handled above\n\n    // Form State\n    const [sellAmount, setSellAmount] = useState(\"\");\n    const [buyAmount, setBuyAmount] = useState(\"\");\n\n    // Combine local loading with context loading\n    const [isLocalLoading, setIsLocalLoading] = useState(false);\n    const isLoading = isContextLoading || isLocalLoading;\n\n    // Tokens\n    const sourceTokens = direction === 'MOV_TO_SOL' ? MOV_TOKENS : SOL_TOKENS;\n    const destTokens = direction === 'MOV_TO_SOL' ? SOL_TOKENS : MOV_TOKENS;\n\n    const [sellToken, setSellToken] = useState(sourceTokens[0]);\n    const [buyToken, setBuyToken] = useState(destTokens[0]);\n\n    // Update tokens when direction changes\n    useEffect(() => {\n        setSellToken(sourceTokens[0]);\n        setBuyToken(destTokens[0]);\n    }, [direction]);\n\n    // Prices\n    const [prices, setPrices] = useState<Record<string, number>>({});\n\n    // Network Switching Logic\n    useEffect(() => {\n        if (direction === 'MOV_TO_SOL' && aptos.connected && aptos.network) {\n            // ... logic ...\n        }\n    }, [direction, aptos.connected, aptos.network]);\n\n\n    // Fetch Prices (Pyth)\n    useEffect(() => {\n        const fetchPrices = async () => {\n            try {\n                const data = await PriceService.getLatestPrices();\n                const formatted: Record<string, number> = {};\n\n                if (data['MOVE']) formatted['MOVE'] = PriceService.formatPrice(data['MOVE']);\n                if (data['SOL']) formatted['SOL'] = PriceService.formatPrice(data['SOL']);\n                if (data['USDC']) formatted['USDC'] = PriceService.formatPrice(data['USDC']);\n\n                setPrices(formatted);\n            } catch (e) {\n                console.error(\"Price fetch failed\", e);\n            }\n        };\n        fetchPrices();\n        const interval = setInterval(fetchPrices, 10000);\n        return () => clearInterval(interval);\n    }, []);\n\n    // Calc Output\n    useEffect(() => {\n        if (!sellAmount || isNaN(parseFloat(sellAmount))) {\n            setBuyAmount(\"\");\n            return;\n        }\n\n        const sPrice = prices[sellToken.symbol] || (sellToken.symbol === \"SOL\" ? 150 : 1);\n        const bPrice = prices[buyToken.symbol] || (buyToken.symbol === \"SOL\" ? 150 : 1);\n\n        const valUSD = parseFloat(sellAmount) * sPrice;\n        const bAmount = valUSD / bPrice;\n\n        // Apply 1% Slippage/Fee for cross chain\n        const afterFee = bAmount * 0.99;\n\n        setBuyAmount(afterFee.toFixed(6));\n    }, [sellAmount, sellToken, buyToken, prices]);\n\n\n    const handleSwap = async () => {\n        if (!aptos.account || !aptos.wallet) {\n            toast.error(\"Please connect your Movement wallet\");\n            return;\n        }\n        if (!solana.publicKey) {\n            toast.error(\"Please connect your Solana wallet\");\n            return;\n        }\n\n        setIsLocalLoading(true);\n        try {\n            if (direction === 'MOV_TO_SOL') {\n                await createMovementToSolanaSwap(sellAmount, buyAmount, solana.publicKey.toString());\n            } else {\n                await createSolanaToMovementSwap(sellAmount, buyAmount, aptos.account.address.toString());\n            }\n\n            setSellAmount(\"\");\n        } catch (e: any) {\n            console.error(e);\n            toast.error(\"Swap Failed\");\n        } finally {\n            setIsLocalLoading(false);\n        }\n    };\n\n    return (\n        <div className=\"flex flex-col items-center justify-center min-h-[80vh] gap-8\">\n            <h1 className=\"text-4xl font-heading font-bold gradient-text\">Cross-Chain Instant Swap</h1>\n\n            <div className=\"flex flex-wrap gap-8 justify-center w-full max-w-5xl\">\n\n                {/* SWAP CARD */}\n                <Card className=\"w-full max-w-[480px] shadow-2xl border-primary/20 bg-card/60 backdrop-blur-sm\">\n                    <CardHeader>\n                        <CardTitle className=\"flex justify-between items-center\">\n                            <span>Swap</span>\n                            <div className=\"flex items-center gap-2 text-sm font-normal\">\n                                <div className={`flex items-center gap-1 ${direction === 'MOV_TO_SOL' ? \"text-primary font-bold\" : \"text-muted-foreground\"}`}>\n                                    <img src=\"https://raw.githubusercontent.com/kitelabs-io/mvmt-tokens/main/logos/MOVE.png\" className=\"w-4 h-4 rounded-full\" alt=\"Movement\" />\n                                    <span>Movement</span>\n                                </div>\n                                <ArrowLeftRight className=\"h-4 w-4\" />\n                                <div className={`flex items-center gap-1 ${direction === 'SOL_TO_MOV' ? \"text-primary font-bold\" : \"text-muted-foreground\"}`}>\n                                    <img src=\"/assets/solanaLogo.png\" className=\"w-4 h-4\" alt=\"Solana\" />\n                                    <span>Solana</span>\n                                </div>\n                            </div>\n                        </CardTitle>\n                    </CardHeader>\n\n                    <CardContent className=\"space-y-4\">\n                        {/* Source Input */}\n                        <div className=\"bg-muted/40 p-4 rounded-xl space-y-2\">\n                            <Label className=\"text-xs text-muted-foreground\">From ({direction === 'MOV_TO_SOL' ? 'Movement' : 'Solana'})</Label>\n                            <div className=\"flex gap-2\">\n                                <Input\n                                    type=\"number\"\n                                    className=\"text-2xl font-bold border-none bg-transparent p-0 focus-visible:ring-0 shadow-none h-auto\"\n                                    placeholder=\"0.00\"\n                                    value={sellAmount}\n                                    onChange={e => setSellAmount(e.target.value)}\n                                />\n                                <Button variant=\"outline\" className=\"min-w-[100px] font-bold\">\n                                    {sellToken.symbol}\n                                </Button>\n                            </div>\n                            <div className=\"text-xs text-muted-foreground flex justify-between\">\n                                <span>$ --</span>\n                                <span>Balance: --</span>\n                            </div>\n                        </div>\n\n                        {/* Switcher */}\n                        <div className=\"flex justify-center -my-2 relative z-10\">\n                            <Button\n                                size=\"icon\"\n                                variant=\"secondary\"\n                                className=\"rounded-full border-4 border-background h-10 w-10\"\n                                onClick={() => setDirection(d => d === 'MOV_TO_SOL' ? 'SOL_TO_MOV' : 'MOV_TO_SOL')}\n                            >\n                                <ArrowDown className=\"h-4 w-4\" />\n                            </Button>\n                        </div>\n\n                        {/* Dest Input */}\n                        <div className=\"bg-muted/40 p-4 rounded-xl space-y-2\">\n                            <Label className=\"text-xs text-muted-foreground\">To ({direction === 'MOV_TO_SOL' ? 'Solana' : 'Movement'})</Label>\n                            <div className=\"flex gap-2\">\n                                <Input\n                                    type=\"number\"\n                                    className=\"text-2xl font-bold border-none bg-transparent p-0 focus-visible:ring-0 shadow-none h-auto\"\n                                    placeholder=\"0.00\"\n                                    value={buyAmount}\n                                    readOnly\n                                />\n                                <Button variant=\"outline\" className=\"min-w-[100px] font-bold\">\n                                    {buyToken.symbol}\n                                </Button>\n                            </div>\n                            <div className=\"text-xs text-muted-foreground flex justify-between\">\n                                <span>~ $ --</span>\n                                <span className=\"text-green-500 flex items-center gap-1\"><Zap className=\"h-3 w-3\" /> Instant Fill by Relayer</span>\n                            </div>\n                        </div>\n\n                    </CardContent>\n\n                    <CardFooter className=\"flex flex-col gap-4\">\n                        <Button\n                            className=\"w-full h-12 text-lg font-bold\"\n                            disabled={isLoading || (!sellAmount && (\n                                (direction === 'MOV_TO_SOL' && aptos.connected) ||\n                                (direction === 'SOL_TO_MOV' && solana.connected)\n                            ))}\n                            onClick={() => {\n                                if (direction === 'MOV_TO_SOL') {\n                                    if (!aptos.connected) {\n                                        aptos.connect();\n                                    } else {\n                                        handleSwap();\n                                    }\n                                } else {\n                                    if (!solana.connected) {\n                                        setVisible(true);\n                                    } else {\n                                        handleSwap();\n                                    }\n                                }\n                            }}\n                        >\n                            {isLoading ? <><Loader2 className=\"mr-2 animate-spin\" /> Processing</> :\n                                (direction === 'MOV_TO_SOL' && !aptos.connected) ? \"Connect Movement Wallet\" :\n                                    (direction === 'SOL_TO_MOV' && !solana.connected) ? \"Connect Solana Wallet\" :\n                                        \"Swap Now\"}\n                        </Button>\n\n                        {/* WALLET STATUS */}\n                        <div className=\"grid grid-cols-2 gap-4 w-full\">\n                            <div className=\"flex flex-col items-center gap-2 p-2 rounded-lg bg-muted/50\">\n                                <span className=\"text-xs font-bold text-muted-foreground\">Movement</span>\n                                {aptos.connected ? (\n                                    <div className=\"text-xs text-green-500 font-mono truncate w-full text-center\">\n                                        {aptos.account?.address.toString().slice(0, 6)}...\n                                    </div>\n                                ) : (\n                                    <Button size=\"sm\" variant=\"ghost\" className=\"h-6 text-xs\" onClick={() => (document.querySelector('.wallet-adapter-button') as HTMLElement)?.click()}>\n                                        Connect\n                                    </Button>\n                                )}\n                            </div>\n\n                            <div className=\"flex flex-col items-center gap-2 p-2 rounded-lg bg-muted/50\">\n                                <span className=\"text-xs font-bold text-muted-foreground\">Solana</span>\n                                {solana.connected ? (\n                                    <div className=\"text-xs text-green-500 font-mono truncate w-full text-center\">\n                                        {solana.publicKey?.toBase58().slice(0, 6)}...\n                                    </div>\n                                ) : (\n                                    <WalletMultiButton style={{ height: '24px', fontSize: '12px', padding: '0 12px' }} />\n                                )}\n                            </div>\n                        </div>\n                    </CardFooter>\n                </Card>\n\n                {/* INFO / ORACLE PANEL */}\n                <div className=\"w-full max-w-[350px] space-y-6\">\n                    <Card>\n                        <CardHeader>\n                            <CardTitle className=\"text-sm\">Live Oracle Rates (Pyth)</CardTitle>\n                        </CardHeader>\n                        <CardContent className=\"space-y-2\">\n                            <div className=\"flex justify-between text-sm\">\n                                <span>MOVE/USD</span>\n                                <span className=\"font-mono text-green-400\">\n                                    {prices['MOVE'] ? `$${prices['MOVE']}` : <Loader2 className=\"h-3 w-3 animate-spin\" />}\n                                </span>\n                            </div>\n                            <div className=\"flex justify-between text-sm\">\n                                <span>SOL/USD</span>\n                                <span className=\"font-mono text-blue-400\">\n                                    {prices['SOL'] ? `$${prices['SOL']}` : <Loader2 className=\"h-3 w-3 animate-spin\" />}\n                                </span>\n                            </div>\n                            <div className=\"border-t border-border/50 my-2 pt-2\"></div>\n                            <div className=\"flex justify-between text-sm font-semibold\">\n                                <span>Rate</span>\n                                <span className=\"font-mono text-yellow-400\">\n                                    {prices['SOL'] && prices['MOVE']\n                                        ? `1 SOL ≈ ${(prices['SOL'] / prices['MOVE']).toFixed(2)} MOVE`\n                                        : <Loader2 className=\"h-3 w-3 animate-spin\" />\n                                    }\n                                </span>\n                            </div>\n                            <div className=\"text-xs text-muted-foreground mt-4\">\n                                * Prices updated every 15s via Pyth Network.\n                            </div>\n                        </CardContent>\n                    </Card>\n\n                    <Card className=\"bg-gradient-to-br from-primary/10 to-transparent border-primary/20\">\n                        <CardHeader>\n                            <CardTitle className=\"text-sm flex items-center gap-2\"><RotateCw className=\"h-4 w-4\" /> How it works</CardTitle>\n                        </CardHeader>\n                        <CardContent className=\"text-sm text-muted-foreground space-y-2\">\n                            <p>1. You sign an intent to swap {sellToken.symbol} for {buyToken.symbol}.</p>\n                            <p>2. Our <strong>Intent Relayer</strong> detects your order.</p>\n                            <p>3. The Relayer <strong>instantly fills</strong> your order on the destination chain using its own liquidity.</p>\n                            <p>4. No waiting for bridges. Atomic & Trustless.</p>\n                        </CardContent>\n                    </Card>\n                </div>\n\n            </div>\n        </div>\n    );\n}\n\n// Icon Helper\nfunction Zap({ className }: { className?: string }) {\n    return (\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\" className={className}>\n            <path fillRule=\"evenodd\" d=\"M14.615 1.595a.75.75 0 01.359.852L12.982 9.75h7.268a.75.75 0 01.548 1.262l-10.5 11.25a.75.75 0 01-1.272-.71l1.992-7.302H3.75a.75.75 0 01-.548-1.262l10.5-11.25a.75.75 0 01.913-.143z\" clipRule=\"evenodd\" />\n        </svg>\n    )\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/antony/intent-protocol/packages/frontend/src/pages/CrossOrders.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadOrders'. Either include it or remove the dependency array.","line":48,"column":8,"nodeType":"ArrayExpression","endLine":48,"endColumn":41,"suggestions":[{"desc":"Update the dependencies array to be: [aptosConnected, loadOrders, solanaConnected]","fix":{"range":[2034,2067],"text":"[aptosConnected, loadOrders, solanaConnected]"}}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":81,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":81,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3521,3524],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3521,3524],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'e' is defined but never used.","line":87,"column":18,"nodeType":null,"messageId":"unusedVar","endLine":87,"endColumn":19},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":185,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":185,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7527,7530],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7527,7530],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\nimport { useState, useEffect } from 'react';\nimport { useWallet } from '@/context/wallet-provider'; // Aptos\nimport { useWallet as useSolanaWallet } from '@solana/wallet-adapter-react'; // Solana\nimport { Button } from '@/components/ui/button';\nimport { ArrowRight, ExternalLink, RefreshCw, CheckCircle, Clock, Link as LinkIcon, LogOut, ArrowLeftRight } from 'lucide-react';\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Badge } from '@/components/ui/badge';\nimport axios from 'axios';\nimport { toast } from 'sonner';\nimport { signAndSubmitTransaction } from \"@/lib/wallet/adapter\";\n\n\ninterface CrossChainIntent {\n    id: string;\n    direction: 'MOV_TO_SOL' | 'SOL_TO_MOV';\n    makerAddress: string;\n    recipientAddress: string;\n    sellAmount: string; // amount in lowest unit\n    buyAmount: string;\n    hashlock: string;\n    status: 'PENDING' | 'SOURCE_LOCKED' | 'DEST_FILLED' | 'DEST_CLAIMED' | 'SOURCE_CLAIMED' | 'COMPLETED' | 'REFUNDED' | 'FAILED';\n    createdAt: number;\n    sourceLockTx?: string;\n    destFillTx?: string;\n    sourceClaimTx?: string;\n    destClaimTx?: string;\n    destEscrowId?: string;\n    sourceEscrowId?: string;\n}\n\nexport default function CrossOrders() {\n    const { connected: aptosConnected, account: aptosAccount, wallet: aptosWallet, connect: connectAptos, disconnect: disconnectAptos } = useWallet();\n    const { connected: solanaConnected, publicKey: solanaPublicKey, connect: connectSolana, disconnect: disconnectSolana, select: selectSolanaWallet, wallets: solanaWallets } = useSolanaWallet();\n\n    const [orders, setOrders] = useState<CrossChainIntent[]>([]);\n    const [isLoading, setIsLoading] = useState(false);\n\n    const [relayerHealth, setRelayerHealth] = useState({ movement: false, solana: false });\n    const [isHealthLoading, setIsHealthLoading] = useState(true);\n\n    // --- Wallet Sync Logic ---\n    useEffect(() => {\n        if (aptosConnected || solanaConnected) {\n            loadOrders();\n        }\n        checkRelayerHealth();\n    }, [aptosConnected, solanaConnected]);\n\n    const loadOrders = async () => {\n        setIsLoading(true);\n        try {\n            const res = await axios.get('http://localhost:3003/orders');\n            const { active, completed } = res.data;\n            const allOrders: CrossChainIntent[] = [...active, ...completed];\n\n            // Filter by connected wallets\n            const filtered = allOrders.filter(o => {\n                const isMakerAptos = aptosAccount && o.makerAddress === aptosAccount.address.toString();\n                const isRecipientAptos = aptosAccount && o.recipientAddress === aptosAccount.address.toString();\n                const isMakerSol = solanaPublicKey && o.makerAddress === solanaPublicKey.toString();\n                const isRecipientSol = solanaPublicKey && o.recipientAddress === solanaPublicKey.toString();\n\n                return isMakerAptos || isRecipientAptos || isMakerSol || isRecipientSol;\n            });\n\n            // Sort by createdAt desc\n            filtered.sort((a, b) => b.createdAt - a.createdAt);\n            setOrders(filtered);\n        } catch (e) {\n            console.error(\"Failed to load orders\", e);\n        } finally {\n            setIsLoading(false);\n        }\n    };\n\n    const checkRelayerHealth = async () => {\n        setIsHealthLoading(true);\n        try {\n            const res = await fetch('http://localhost:3003/health').catch(() => ({ ok: false, json: async () => ({}) }));\n            const data = await (res as any).json();\n\n            setRelayerHealth({\n                movement: data.movement?.connected || false,\n                solana: data.solana?.connected || false\n            });\n        } catch (e) {\n            toast.warning(\"Relayer Unreachable\");\n        } finally {\n            setTimeout(() => setIsHealthLoading(false), 800); // 800ms min delay for UX\n        }\n    };\n\n    const getExplorerLink = (hash: string | undefined, chain: 'MOVE' | 'SOL') => {\n        if (!hash) return '#';\n        if (chain === 'MOVE') return `https://explorer.movementlabs.xyz/txn/${hash}?network=testnet`;\n        if (chain === 'SOL') return `https://solscan.io/tx/${hash}?cluster=devnet`;\n        return '#';\n    };\n\n    const handleSolanaConnect = () => {\n        const phantom = solanaWallets.find(w => w.adapter.name === 'Phantom');\n        if (phantom) {\n            selectSolanaWallet(phantom.adapter.name);\n            connectSolana();\n        } else {\n            alert(\"Please install Phantom wallet!\");\n        }\n    };\n\n    const handleClaim = async (order: CrossChainIntent) => {\n        try {\n            const hashlock = order.hashlock;\n\n            // 1. Retrieve Secret from LocalStorage\n            const stored = localStorage.getItem('cross_chain_pending');\n            const pending = stored ? JSON.parse(stored) : {};\n            // Look for matching hashlock\n            const swapData = pending[hashlock];\n\n            if (!swapData || !swapData.secret) {\n                toast.error(\"Secret not found!\", { description: \"This order was not initiated from this browser or storage was cleared.\" });\n                return;\n            }\n\n            const secret = swapData.secret;\n\n            if (order.direction === 'MOV_TO_SOL') {\n                // MOVE -> SOL: User needs to Reveal Secret to Relayer to get paid (Trusted Mode)\n                toast.info(\"Revealing secret to Relayer...\");\n\n                await axios.post(`http://localhost:3003/reveal-secret`, {\n                    intentId: order.id,\n                    secret: secret\n                });\n\n                toast.success(\"Secret Revealed! Funds should arrive in your Solana wallet shortly.\");\n\n            } else {\n                // SOL -> MOVE: User claims on Movement Chain\n                if (!aptosConnected || !aptosAccount) {\n                    toast.error(\"Please connect movement wallet first\");\n                    return;\n                }\n\n                toast.info(\"Claiming on Movement...\");\n                const MOVEMENT_HTLC_ADDR = \"0x485ca1c12b5dfa01c282b9c7ef09fdfebbf877ed729bf999ce61a8ec5c5e69bd\";\n\n                // Use destEscrowId from order\n                const escrowId = order.destEscrowId;\n                if (escrowId === undefined) {\n                    throw new Error(\"Relayer has not provided Destination Escrow ID yet.\");\n                }\n\n                // Convert secret hex to byte array\n                const secretBytes = new Uint8Array(secret.match(/.{1,2}/g)!.map((byte: string) => parseInt(byte, 16)));\n\n                if (!aptosWallet) {\n                    toast.error(\"Wallet not connected\");\n                    return;\n                }\n\n                const response = await signAndSubmitTransaction(aptosWallet, {\n                    function: `${MOVEMENT_HTLC_ADDR}::htlc_escrow::claim`,\n                    typeArguments: [\"0x1::aptos_coin::AptosCoin\"],\n                    functionArguments: [\n                        MOVEMENT_HTLC_ADDR,\n                        escrowId,\n                        Array.from(secretBytes)\n                    ]\n                });\n\n                console.log(\"Claim Tx:\", response);\n                toast.success(\"Claimed Successfully on Movement!\");\n\n                // Notify Relayer\n                await axios.post(`http://localhost:3003/reveal-secret`, {\n                    intentId: order.id,\n                    secret: secret\n                });\n            }\n\n            setTimeout(loadOrders, 2000);\n\n        } catch (e: any) {\n            console.error(e);\n            toast.error(\"Claim Failed\", { description: e.message });\n        }\n    };\n\n    return (\n        <div className=\"container mx-auto py-10 max-w-6xl\">\n            <div className=\"flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4\">\n                <div>\n                    <h1 className=\"text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-yellow-400 to-orange-600\">\n                        Cross-Chain Swaps\n                    </h1>\n                    <div className=\"flex items-center gap-4 mt-2\">\n                        <div className=\"flex items-center gap-2 text-muted-foreground\">\n                            <img src=\"https://raw.githubusercontent.com/kitelabs-io/mvmt-tokens/main/logos/MOVE.png\" className=\"w-5 h-5 rounded-full\" alt=\"Movement\" />\n                            <span>Movement</span>\n                            <ArrowLeftRight className=\"h-4 w-4 mx-1\" />\n                            <img src=\"/assets/solanaLogo.png\" className=\"w-5 h-5\" alt=\"Solana\" />\n                            <span>Solana</span>\n                        </div>\n                        {/* Health Badges */}\n                        <div className=\"flex gap-2 text-[10px] font-mono\">\n                            <Badge variant={relayerHealth.movement ? \"outline\" : \"secondary\"} className={relayerHealth.movement ? \"text-green-500 border-green-500/30\" : \"text-yellow-500 border-yellow-500/30\"}>\n                                RELAYER: {isHealthLoading ? 'CHECKING...' : (relayerHealth.movement ? 'ONLINE' : 'OFFLINE')}\n                            </Badge>\n                            <Badge variant={relayerHealth.solana ? \"outline\" : \"secondary\"} className={relayerHealth.solana ? \"text-green-500 border-green-500/30\" : \"text-yellow-500 border-yellow-500/30\"}>\n                                SOL-WORKER: {isHealthLoading ? 'CHECKING...' : (relayerHealth.solana ? 'ONLINE' : 'OFFLINE')}\n                            </Badge>\n                        </div>\n                    </div>\n                </div>\n                <div className=\"flex gap-2\">\n                    <Button variant=\"outline\" onClick={loadOrders} disabled={isLoading}>\n                        <RefreshCw className={`mr-2 h-4 w-4 ${isLoading ? 'animate-spin' : ''}`} />\n                        Refresh\n                    </Button>\n                </div>\n            </div>\n\n            {/* Wallet Status Area */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 mb-8\">\n                {/* Movement Wallet */}\n                <Card className={`border-l-4 ${aptosConnected ? 'border-l-green-500' : 'border-l-red-500'} bg-card/50`}>\n                    <CardHeader className=\"pb-2 flex flex-row items-center justify-between\">\n                        <CardTitle className=\"text-sm font-medium text-yellow-500\">Movement Wallet</CardTitle>\n                        {aptosConnected ? (\n                            <Button variant=\"ghost\" size=\"sm\" onClick={() => disconnectAptos()} className=\"h-6 w-6 p-0 text-muted-foreground hover:text-red-500\">\n                                <LogOut className=\"h-3 w-3\" />\n                            </Button>\n                        ) : (\n                            <Button variant=\"outline\" size=\"sm\" onClick={connectAptos} className=\"h-7 text-xs\">\n                                Connect\n                            </Button>\n                        )}\n                    </CardHeader>\n                    <CardContent>\n                        <div className=\"flex items-center gap-2\">\n                            <div className={`w-2 h-2 rounded-full ${aptosConnected ? 'bg-green-500' : 'bg-red-500'}`} />\n                            <span className=\"font-mono text-xs\">\n                                {aptosConnected ? aptosAccount?.address.toString().slice(0, 15) + '...' : 'Not Connected'}\n                            </span>\n                        </div>\n                    </CardContent>\n                </Card>\n\n                {/* Solana Wallet */}\n                <Card className={`border-l-4 ${solanaConnected ? 'border-l-green-500' : 'border-l-red-500'} bg-card/50`}>\n                    <CardHeader className=\"pb-2 flex flex-row items-center justify-between\">\n                        <CardTitle className=\"text-sm font-medium text-purple-500\">Solana Wallet</CardTitle>\n                        {solanaConnected ? (\n                            <Button variant=\"ghost\" size=\"sm\" onClick={() => disconnectSolana()} className=\"h-6 w-6 p-0 text-muted-foreground hover:text-red-500\">\n                                <LogOut className=\"h-3 w-3\" />\n                            </Button>\n                        ) : (\n                            <Button variant=\"outline\" size=\"sm\" onClick={handleSolanaConnect} className=\"h-7 text-xs\">\n                                Connect Phantom\n                            </Button>\n                        )}\n                    </CardHeader>\n                    <CardContent>\n                        <div className=\"flex items-center gap-2\">\n                            <div className={`w-2 h-2 rounded-full ${solanaConnected ? 'bg-green-500' : 'bg-red-500'}`} />\n                            <span className=\"font-mono text-xs\">\n                                {solanaConnected ? solanaPublicKey?.toString().slice(0, 15) + '...' : 'Not Connected'}\n                            </span>\n                        </div>\n                    </CardContent>\n                </Card>\n            </div>\n\n            {/* Orders List */}\n            <div className=\"space-y-4\">\n                {orders.length === 0 ? (\n                    <div className=\"text-center py-20 bg-muted/30 rounded-lg\">\n                        <p className=\"text-muted-foreground\">No cross-chain swaps found for connected wallets.</p>\n                        {(!aptosConnected || !solanaConnected) && <p className=\"text-xs text-yellow-500 mt-2\">Make sure both wallets are connected.</p>}\n                    </div>\n                ) : (\n                    orders.map((order) => {\n                        const isMoveToSol = order.direction === 'MOV_TO_SOL';\n                        const sourceChain = isMoveToSol ? 'MOVE' : 'SOL';\n                        const destChain = isMoveToSol ? 'SOL' : 'MOVE';\n\n                        // Status Logic\n                        const isSourceLocked = order.status !== 'PENDING' && order.status !== 'FAILED';\n                        const isDestFilled = order.status === 'DEST_FILLED' || order.status === 'DEST_CLAIMED' || order.status === 'COMPLETED'; // Relayer filled.\n                        const isClaimed = order.status === 'DEST_CLAIMED' || order.status === 'COMPLETED' || order.status === 'SOURCE_CLAIMED';\n\n                        return (\n                            <Card key={order.id} className=\"overflow-hidden border-border/50 transition-all hover:border-yellow-500/50\">\n                                <div className=\"p-6\">\n                                    <div className=\"flex flex-col md:flex-row justify-between gap-6\">\n                                        {/* Header Info */}\n                                        <div className=\"flex-1\">\n                                            <div className=\"flex items-center gap-3 mb-2\">\n                                                <Badge variant=\"outline\" className={`text-xs ${isMoveToSol ? 'bg-yellow-500/10 text-yellow-500 border-yellow-500/20' : 'bg-purple-500/10 text-purple-500 border-purple-500/20'}`}>\n                                                    {isMoveToSol ? 'MOVE → SOL' : 'SOL → MOVE'}\n                                                </Badge>\n                                                <span className=\"text-xs text-muted-foreground\">\n                                                    {new Date(order.createdAt).toLocaleString()}\n                                                </span>\n                                            </div>\n                                            <div className=\"flex items-center gap-4 text-xl font-bold\">\n                                                <span>{parseInt(order.sellAmount) / (isMoveToSol ? 1e8 : 1e9)} {isMoveToSol ? 'MOVE' : 'SOL'}</span>\n                                                <ArrowRight className=\"text-muted-foreground h-5 w-5\" />\n                                                <span>{parseInt(order.buyAmount) / (isMoveToSol ? 1e9 : 1e8)} {isMoveToSol ? 'SOL' : 'MOVE'}</span>\n                                            </div>\n                                            <div className=\"text-xs text-muted-foreground mt-2 font-mono truncate max-w-[300px]\">\n                                                ID: {order.id}\n                                            </div>\n                                        </div>\n\n                                        {/* Visual Stepper */}\n                                        <div className=\"flex-1 flex items-center justify-center gap-2 min-w-[300px]\">\n                                            {/* Step 1: Lock */}\n                                            <div className=\"flex flex-col items-center\">\n                                                <div className={`w-8 h-8 rounded-full flex items-center justify-center mb-1 ${isSourceLocked ? 'bg-green-500/20 text-green-500' : 'bg-muted/20 text-muted-foreground'}`}>\n                                                    <CheckCircle className=\"h-5 w-5\" />\n                                                </div>\n                                                <span className=\"text-[10px] font-mono text-muted-foreground\">LOCKED</span>\n                                            </div>\n                                            <div className={`h-[2px] w-12 ${isSourceLocked ? 'bg-green-500/50' : 'bg-muted'}`} />\n\n                                            {/* Step 2: Relayer Fill */}\n                                            <div className=\"flex flex-col items-center\">\n                                                <div className={`w-8 h-8 rounded-full flex items-center justify-center mb-1 ${isDestFilled ? 'bg-green-500/20 text-green-500' : (isSourceLocked ? 'bg-yellow-500/20 text-yellow-500 animate-pulse' : 'bg-muted/20 text-muted-foreground')}`}>\n                                                    {isDestFilled ? <CheckCircle className=\"h-5 w-5\" /> : <Clock className=\"h-5 w-5\" />}\n                                                </div>\n                                                <span className=\"text-[10px] font-mono text-muted-foreground\">RELAYER OK</span>\n                                            </div>\n                                            <div className={`h-[2px] w-12 ${isDestFilled ? 'bg-green-500/50' : 'bg-muted'}`} />\n\n                                            {/* Step 3: Claim */}\n                                            <div className=\"flex flex-col items-center\">\n                                                {/* Show Claim button if DEST_FILLED, else Status */}\n                                                {(order.status === 'DEST_FILLED') ? (\n                                                    <Button size=\"sm\" variant=\"default\" className=\"h-8 rounded-full px-4 bg-green-600 hover:bg-green-700 animate-pulse\" onClick={() => handleClaim(order)}>\n                                                        CLAIM\n                                                    </Button>\n                                                ) : (\n                                                    <>\n                                                        <div className={`w-8 h-8 rounded-full flex items-center justify-center mb-1 ${isClaimed ? 'bg-green-500/20 text-green-500' : 'bg-muted/20 text-muted-foreground'}`}>\n                                                            <CheckCircle className=\"h-5 w-5\" />\n                                                        </div>\n                                                        <span className=\"text-[10px] font-mono text-muted-foreground\">SETTLED</span>\n                                                    </>\n                                                )}\n                                            </div>\n                                        </div>\n\n                                        {/* Links */}\n                                        <div className=\"flex flex-col gap-2 justify-center min-w-[150px]\">\n                                            <a\n                                                href={getExplorerLink(order.sourceLockTx || order.sourceEscrowId, sourceChain)}\n                                                target=\"_blank\"\n                                                rel=\"noreferrer\"\n                                                className=\"flex items-center gap-2 text-xs text-yellow-500 hover:text-yellow-400\"\n                                            >\n                                                <LinkIcon className=\"h-3 w-3\" />\n                                                Lock Tx\n                                            </a>\n                                            {order.destFillTx && (\n                                                <a\n                                                    href={getExplorerLink(order.destFillTx, destChain)}\n                                                    target=\"_blank\"\n                                                    rel=\"noreferrer\"\n                                                    className=\"flex items-center gap-2 text-xs text-purple-500 hover:text-purple-400\"\n                                                >\n                                                    <ExternalLink className=\"h-3 w-3\" />\n                                                    Fill Tx\n                                                </a>\n                                            )}\n                                            {order.destClaimTx && (\n                                                <a\n                                                    href={getExplorerLink(order.destClaimTx, destChain)}\n                                                    target=\"_blank\"\n                                                    rel=\"noreferrer\"\n                                                    className=\"flex items-center gap-2 text-xs text-green-500 hover:text-green-400\"\n                                                >\n                                                    <ExternalLink className=\"h-3 w-3\" />\n                                                    Claim Tx\n                                                </a>\n                                            )}\n                                        </div>\n                                    </div>\n                                </div>\n                            </Card>\n                        );\n                    })\n                )}\n            </div>\n        </div>\n    );\n}\n\n","usedDeprecatedRules":[]},{"filePath":"/home/antony/intent-protocol/packages/frontend/src/pages/KBArticlePage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'node' is defined but never used.","line":114,"column":44,"nodeType":null,"messageId":"unusedVar","endLine":114,"endColumn":48},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'node' is defined but never used.","line":115,"column":44,"nodeType":null,"messageId":"unusedVar","endLine":115,"endColumn":48},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":